<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card header: stop name + metadata/pills + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/stopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:letterSpacing="-0.01" />

                <!-- Subtitle with Commute Pills and Stop Metadata -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/homeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠 Home"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_home_pill"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1.5dp"
                        android:layout_marginEnd="6dp"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/workBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💼 Work"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_work_pill"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1.5dp"
                        android:layout_marginEnd="6dp"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/offlineIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="Offline"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/warning_orange"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/rblNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:fontFamily="sans-serif"
                        android:ellipsize="end"
                        android:maxLines="1" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/dragHandle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_drag_handle"
                app:tint="@color/text_tertiary"
                android:contentDescription="Drag to reorder"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteBtn"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/text_tertiary"
                app:iconSize="18dp"
                android:backgroundTint="@android:color/transparent"
                android:contentDescription="Delete stop" />

        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/separator"
            android:layout_marginBottom="10dp" />

        <!-- Line Disruption Alert Banner (Wiener Linien Traffic Info) -->
        <LinearLayout
            android:id="@+id/disruptionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_line_chip"
            android:backgroundTint="#33FF9F0A"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/disruptionText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF9F0A"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Departure rows (custom compound views) -->
        <com.wienerlinien.app.ui.DepartureRowView
            android:id="@+id/dep1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:visibility="gone" />

        <com.wienerlinien.app.ui.DepartureRowView
            android:id="@+id/dep2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:visibility="gone" />

        <com.wienerlinien.app.ui.DepartureRowView
            android:id="@+id/dep3"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:visibility="gone" />

        <com.wienerlinien.app.ui.DepartureRowView
            android:id="@+id/dep4"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:visibility="gone" />

        <!-- No data placeholder -->
        <TextView
            android:id="@+id/noDataText"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Fetching departures…"
            android:textSize="14sp"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif"
            android:visibility="visible" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
